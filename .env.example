# DRISHTI MVP — Environment Configuration
# Copy this file to .env and edit the values for your environment.
# .env is in .gitignore and will NOT be committed to version control.

# ---------------------------------------------------------------------------
# AI MODEL PATHS
# Point these at a fine-tuned model once you have one trained.
# Relative paths are resolved from the project root.
# ---------------------------------------------------------------------------
OBJECT_MODEL_PATH=models/yolov8n.pt
POSE_MODEL_PATH=models/yolov8n-pose.pt

# Device for inference: auto | cpu | cuda | mps
# "auto" lets Ultralytics pick the best available device.
DEVICE=auto

# ---------------------------------------------------------------------------
# INFERENCE PERFORMANCE
# TARGET RANGE: 8–15 FPS. Higher = more CPU/GPU load.
# ---------------------------------------------------------------------------
ANALYSIS_FPS=10

# ---------------------------------------------------------------------------
# CONFIDENCE THRESHOLDS (0.0 – 1.0)
# Lower = more sensitive, more false positives.
# Higher = misses weaker detections.
# ---------------------------------------------------------------------------
OBJECT_CONFIDENCE_THRESHOLD=0.25
PHONE_CONFIDENCE_THRESHOLD=0.40
POSE_CONFIDENCE_THRESHOLD=0.50

# ---------------------------------------------------------------------------
# BEHAVIOUR THRESHOLDS
# HEAD_TURN_THRESHOLD: ratio of head offset to shoulder width (0–1)
# BODY_ROTATION_THRESHOLD: same metric for shoulder asymmetry
# HAND_MOVEMENT_THRESHOLD: normalized wrist distance from shoulder
# ---------------------------------------------------------------------------
HEAD_TURN_THRESHOLD=0.25
BODY_ROTATION_THRESHOLD=0.25
HAND_MOVEMENT_THRESHOLD=0.5

# ---------------------------------------------------------------------------
# TEMPORAL PERSISTENCE (seconds)
# How long a behaviour must persist before being flagged as confirmed.
# Prevents single-frame false alarms.
# ---------------------------------------------------------------------------
HEAD_TURN_PERSISTENCE_SECONDS=3.0
BODY_ROTATION_PERSISTENCE_SECONDS=3.0
HAND_MOVEMENT_PERSISTENCE_SECONDS=3.0
PHONE_PERSISTENCE_SECONDS=0.5

# ---------------------------------------------------------------------------
# EVENT COOLDOWN (seconds)
# After an event fires, ignore the same category for this long.
# Prevents duplicate database rows / snapshots for the same incident.
# ---------------------------------------------------------------------------
EVENT_COOLDOWN_SECONDS=10.0

# ---------------------------------------------------------------------------
# STORAGE
# ---------------------------------------------------------------------------
EVIDENCE_DIR=evidence
DATABASE_PATH=data/drishti.db

# ---------------------------------------------------------------------------
# DEBUG
# ---------------------------------------------------------------------------
DEBUG_MODE=false
